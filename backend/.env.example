# Trioloo ERP - backend local development environment.
#
# Copy to .env (git-ignored) and fill in local values.
# Never commit real credentials. Never hard-code a secret in application.yml.

# --- Database (TEC 1.2: PostgreSQL 18.x, one authoritative database) ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=trioloo_erp
DB_USERNAME=trioloo
DB_PASSWORD=change-me-locally

# --- Backend HTTP ---
SERVER_PORT=8080

# --- Local development identity (git-ignored .env only; never production) ---
# Enables the development-only bootstrap guarded by the dev-authority profile.
SPRING_PROFILES_ACTIVE=dev-authority
TRIOLOO_DEV_IDENTITY_PROVISION=true
DEV_USERNAME=devuser
DEV_PASSWORD=placeholder

# --- Timezone ---
# TEC-050 fixes Asia/Dhaka as the canonical business timezone. It is applied in code by
# TimeZoneConfiguration and is NOT configurable per environment - this entry documents the
# fact rather than offering a switch.
# TZ=Asia/Dhaka
