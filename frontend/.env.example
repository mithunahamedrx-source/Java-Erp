# Trioloo ERP - frontend local development environment.
#
# Copy to .env.local (git-ignored) and adjust. Never commit real credentials.
# Vite only exposes variables prefixed VITE_ to client code - never put a secret here,
# because everything in this file ships to the browser.

# Backend REST base URL (TEC-090: REST/JSON to Spring Boot).
VITE_API_BASE_URL=http://localhost:8080
