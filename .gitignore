# --- Secrets and local environment (never commit real credentials) ---
.env
.env.local
.env.*.local
*.pem
*.key

# --- Backend (Maven) ---
backend/target/
backend/.mvn/wrapper/maven-wrapper.jar

# --- Frontend (Node / Vite) ---
# Root-level too: a stray tool cache (e.g. Vitest) can create /node_modules outside frontend/.
node_modules/
frontend/node_modules/
frontend/dist/
frontend/*.tsbuildinfo

# --- Local run logs (never committed) ---
*.log
*.err

# --- Local development authority scripts (never committed, never deployed) ---
# Dev-only permission grants for UI review. Not migrations, not a bootstrap.
dev-local/

# --- Tooling / OS ---
.idea/
.vscode/
*.iml
.DS_Store
Thumbs.db

# --- Claude Design working cache (never committed) ---
# A .dc.html bundle ships with an `uploads/` tree holding the assets and DOCUMENT COPIES the
# design session was given. For the Order module prototype that is 13 MB — every architecture
# document duplicated twice, plus pasted screenshots. The design itself is the .dc.html beside
# it; the cache is a second, silently diverging register of documents docs/ already owns.
docs/design-reference/*/uploads/
docs/design-reference/*/.thumbnail
